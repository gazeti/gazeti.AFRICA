# Aleph 3.0.3 environment configuration
# Copy to aleph.env and fill in the values

# App
ALEPH_DEBUG=false
ALEPH_SECRET_KEY=replace-with-random-secret
ALEPH_APP_NAME=opengazettes_ke
ALEPH_APP_TITLE=gazeti.AFRICA
ALEPH_APP_URL=https://api.gazeti.africa
ALEPH_URL_SCHEME=https
ALEPH_LOGO=https://raw.githubusercontent.com/gazeti/gazeti.AFRICA/e361fa9daf71a05a25b7f715c3cbda7e7719ce21/img/logo.png
ALEPH_FAVICON=https://gazeti.africa/favicon.ico

# Auth
ALEPH_PASSWORD_LOGIN=true
ALEPH_OAUTH_KEY=
ALEPH_OAUTH_SECRET=
ALEPH_ADMINS=

# CORS
ALEPH_CORS_ORIGINS=https://gazeti.africa

# Services
ALEPH_DATABASE_URI=postgresql://aleph:aleph@postgres/aleph
ALEPH_ELASTICSEARCH_URI=http://elasticsearch:9200/
ALEPH_BROKER_URI=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379/0
ALEPH_CONVERT_DOCUMENT_URL=http://convert-document:3000/convert

# Storage (local file for dev, switch to s3 for production)
ALEPH_ARCHIVE_TYPE=file
ALEPH_ARCHIVE_PATH=/data
# ALEPH_ARCHIVE_TYPE=s3
# ALEPH_ARCHIVE_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1

# Content
ALEPH_DEFAULT_LANGUAGE=en
ALEPH_REGEX_ENTITIES=true
ALEPH_PDF_OCR_PAGES=true
ALEPH_CACHE=false
ALEPH_QUEUE=true
ALEPH_MAINTENANCE=false
ALEPH_DISABLE_CRAWLERS=false

# Polyglot
POLYGLOT_DATA_PATH=/tmp/polyglot
C_FORCE_ROOT=true

# Mail (optional)
ALEPH_MAIL_FROM=
ALEPH_MAIL_HOST=
ALEPH_MAIL_PORT=25
ALEPH_MAIL_USERNAME=
ALEPH_MAIL_PASSWORD=
ALEPH_MAIL_SSL=false
